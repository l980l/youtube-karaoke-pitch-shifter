{
  "manifest_version": 3,
  "name": "Tono — 유튜브 노래방 키 조절",
  "version": "1.2.1",
  "description": "유튜브 노래방·음악 영상의 키(음정)를 속도 변화 없이 반음 단위로 조절합니다. 곡별 키 기억, 재생 속도, 보컬 줄이기를 지원합니다.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtu.be/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Tono — 키 조절"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtu.be/*"
      ],
      "js": [
        "common/config.js",
        "content/pitch-shifter.js",
        "content/karaoke-ui.js",
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/pitch-worklet.js"
      ],
      "matches": [
        "https://*.youtube.com/*",
        "https://*.youtu.be/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "commands": {
    "pitch-up": {
      "suggested_key": {
        "default": "Alt+Period",
        "mac": "Alt+Period"
      },
      "description": "반음 올리기"
    },
    "pitch-down": {
      "suggested_key": {
        "default": "Alt+Comma",
        "mac": "Alt+Comma"
      },
      "description": "반음 내리기"
    },
    "pitch-reset": {
      "suggested_key": {
        "default": "Alt+0",
        "mac": "Alt+0"
      },
      "description": "원키로"
    },
    "toggle-ui": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "화면 컨트롤 표시/숨기기"
    }
  },
  "short_name": "Tono"
}
